<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<NoWarn>$(NoWarn);CA1707;CS1591;SA1600;SA1623</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="$(RepoRoot)\src\ingest\SData.Ingest.Shared\SData.Ingest.Shared.csproj" />
		<ProjectReference Include="$(RepoRoot)\src\ingest\SData.Ingest.Api\SData.Ingest.Api.csproj" />
		<ProjectReference Include="$(RepoRoot)\src\infra\SData.Infra.Shared\SData.Infra.Shared.csproj" />
		<ProjectReference Include="$(RepoRoot)\src\infra\SData.Infra.Configuration.Shared\SData.Infra.Configuration.Shared.csproj" />
		<ProjectReference Include="$(RepoRoot)\src\store\SData.Store.Shared\SData.Store.Shared.csproj" />
		<ProjectReference Include="$(RepoRoot)\src\settings\SData.Settings.Shared\SData.Settings.Shared.csproj" />
		<ProjectReference Include="$(RepoRoot)\src\database\SData.Database.Shared\SData.Database.Shared.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Caching.Memory" />
		<PackageReference Include="Google.Protobuf" />
		<!-- gRPC 服务基类经由 Grpc.AspNetCore 元包传递的 Grpc.Core.Api 提供（T110；服务注册端在 T112 的 Api 侧） -->
		<PackageReference Include="Grpc.AspNetCore" />
		<PackageReference Include="Grpc.Tools" PrivateAssets="all" />
		<!-- MQ 日志消费客户端（Kafka/RabbitMQ/Pulsar，均默认关闭，见 Consumers/） -->
		<PackageReference Include="Confluent.Kafka" />
		<PackageReference Include="RabbitMQ.Client" />
		<PackageReference Include="DotPulsar" />
	</ItemGroup>

	<!-- OTLP 官方 proto 源（opentelemetry-proto v1.3.2），编译期由 Grpc.Tools 生成 C#（不提交生成物）；Both=服务端基类 + 客户端存根（T112 集成测试用） -->
	<ItemGroup>
		<Protobuf Include="OtlpProtos\opentelemetry\proto\**\*.proto" ProtoRoot="OtlpProtos" GrpcServices="Both" />
	</ItemGroup>

</Project>
