<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<RootNamespace>SData</RootNamespace>
		<NoWarn>$(NoWarn);CA1707;CS1591;SA1600;SA1623</NoWarn>
		<!-- MQTTnet 5.2 起官方拆包：server 独立为 MQTTnet.Server（T000 封板清单遗漏）；以 VersionOverride 引用同版本 5.2.0.1603，避免改动封板的 Directory.Packages.props（T140 决策日志已登记） -->
		<CentralPackageVersionOverrideEnabled>true</CentralPackageVersionOverrideEnabled>
	</PropertyGroup>

	<ItemGroup>
		<Content Update="data\**\*" Watch="false" />
		<None Update="data\**\*" Watch="false" />
		<!-- Runtime state and developer settings must never enter published packages. -->
		<Content Update="data\**\*;configs\**\*;appsettings.Development.json" CopyToPublishDirectory="Never" />
		<None Update="data\**\*;configs\**\*" CopyToPublishDirectory="Never" />
		<!-- 运行时模板只用于生成 runtimeconfig.json，不应进入发布包；单文件下它会被 SDK 当成 Content 复制。 -->
		<None Update="runtimeconfig.template.json" CopyToPublishDirectory="Never" />
		<Content Update="runtimeconfig.template.json" CopyToPublishDirectory="Never" />
	</ItemGroup>

	<ItemGroup>
		<!-- 单一程序集：原拆分项目（Shared/Core/Api/Sqlite）已全部并入本文件，命名空间保持不变，源码位于 {Domain}/{Layer}/。 -->
		<InternalsVisibleTo Include="SData.Ingest.Tests" />
		<InternalsVisibleTo Include="SData.Store.Tests" />
	</ItemGroup>

	<ItemGroup>
		<!-- DuckDB 内嵌 DDL（原 SData.Store.Core）：目录 Store/Core ↔ 原根命名空间 SData.Store.Core，逻辑名 SData.Store.Core.DuckDb.Ddl.*.sql 与拆分时期一致。 -->
		<EmbeddedResource Include="Store\Core\DuckDb\Ddl\*.sql" />
	</ItemGroup>

	<ItemGroup>
		<!-- OTLP 官方 proto 源（opentelemetry-proto v1.3.2），编译期由 Grpc.Tools 生成 C#（不提交生成物）；Both=服务端基类 + 客户端存根（T112 集成测试用） -->
		<Protobuf Include="Ingest\Core\OtlpProtos\opentelemetry\proto\**\*.proto" ProtoRoot="Ingest\Core\OtlpProtos" GrpcServices="Both" />
	</ItemGroup>

	<ItemGroup>
		<!-- 模块框架与横切 -->
		<PackageReference Include="Maomi.Core" />
		<PackageReference Include="MediatR" />
		<PackageReference Include="FluentValidation" />
		<PackageReference Include="Yitter.IdGenerator" />
		<PackageReference Include="Serilog.AspNetCore" />

		<!-- ASP.NET Core / OpenAPI / MCP -->
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
		<PackageReference Include="ModelContextProtocol.AspNetCore" />
		<PackageReference Include="System.IdentityModel.Tokens.Jwt" />

		<!-- 观测 -->
		<PackageReference Include="OpenTelemetry" />
		<PackageReference Include="OpenTelemetry.Extensions.Hosting" />
		<PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
		<PackageReference Include="OpenTelemetry.Instrumentation.Http" />
		<PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
		<PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />

		<!-- 数据访问 -->
		<PackageReference Include="Microsoft.EntityFrameworkCore" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
		<PackageReference Include="DuckDB.NET.Data.Full" />
		<PackageReference Include="AWSSDK.S3" />

		<!-- 缓存 / 配置 / 日志抽象（原各层项目分别引用） -->
		<PackageReference Include="Microsoft.Extensions.Caching.Memory" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
		<PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />

		<!-- OTLP gRPC（Ingest） -->
		<PackageReference Include="Google.Protobuf" />
		<PackageReference Include="Grpc.AspNetCore" />
		<PackageReference Include="Grpc.Tools" PrivateAssets="all" />

		<!-- MQ 日志消费客户端（Kafka/RabbitMQ/Pulsar，均默认关闭，见 Ingest/Core/Consumers/） -->
		<PackageReference Include="Confluent.Kafka" />
		<PackageReference Include="RabbitMQ.Client" />
		<PackageReference Include="DotPulsar" />

		<!-- IoT -->
		<PackageReference Include="MQTTnet" />
		<PackageReference Include="MQTTnet.Server" VersionOverride="5.2.0.1603" />
	</ItemGroup>

</Project>
