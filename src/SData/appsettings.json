{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "SData": {
    "Name": "sdata",
    "Port": 5300,
    "WebUI": true,
    "NotificationAllowedOrigins": [],
    "Listeners": [],
    "Rum": {
      "CorsOrigins": []
    },
    "Database": {
      "Path": "data/sdata.db"
    },
    "DuckDb": {
      "Path": "data/sdata.duckdb"
    },
    "Auth": {
      "InitialAdminPassword": "sdata@123"
    },
    "Ingest": {
      "InitialApiKey": "",
      "BufferCapacity": 100000,
      "BufferByteBudgetBytes": 268435456
    }
  }
}
