<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<NoWarn>$(NoWarn);CA1707;CS1591;SA1600;SA1623</NoWarn>
		<!-- MQTTnet 5.2 起官方拆包：server 独立为 MQTTnet.Server（T000 封板清单遗漏）；以 VersionOverride 引用同版本 5.2.0.1603，避免改动封板的 Directory.Packages.props（T140 决策日志已登记） -->
		<CentralPackageVersionOverrideEnabled>true</CentralPackageVersionOverrideEnabled>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="$(RepoRoot)\src\iot\SData.Iot.Shared\SData.Iot.Shared.csproj" />
		<ProjectReference Include="$(RepoRoot)\src\iot\SData.Iot.Api\SData.Iot.Api.csproj" />
		<ProjectReference Include="$(RepoRoot)\src\infra\SData.Infra.Shared\SData.Infra.Shared.csproj" />
		<ProjectReference Include="$(RepoRoot)\src\infra\SData.Infra.Configuration.Shared\SData.Infra.Configuration.Shared.csproj" />
		<ProjectReference Include="$(RepoRoot)\src\database\SData.Database.Shared\SData.Database.Shared.csproj" />
		<ProjectReference Include="$(RepoRoot)\src\store\SData.Store.Shared\SData.Store.Shared.csproj" />
		<ProjectReference Include="$(RepoRoot)\src\settings\SData.Settings.Shared\SData.Settings.Shared.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
		<PackageReference Include="MQTTnet" />
		<PackageReference Include="MQTTnet.Server" VersionOverride="5.2.0.1603" />
		<PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
	</ItemGroup>

</Project>
