# OpenCover UI analysis results
OpenCover/

# Azure Stream Analytics local run output
ASALocalRun/

# MSBuild Binary and Structured Log
*.binlog

# NVidia Nsight GPU debugger configuration file
*.nvuser

# MFractors (Xamarin productivity tool) working folder
.mfractor/

# Local History for Visual Studio
.localhistory/

# BeatPulse healthcheck temp database
healthchecksdb

# Backup folder for Package Reference Convert tool in Visual Studio 2017
MigrationBackup/

# Ionide (cross platform F# VS Code tools) working folder
.ionide/

# Fody - auto-generated XML schema
FodyWeavers.xsd
appsettings.Development.json
/.idea
.DS_Store
/src/MaomiAI/MaomiAI.json

# 本地开发私有配置（含密码/IP，勿提交；脚本与截图保留）
local-dev/appsettings.Development.json
local-dev/system.local.json
local-dev/system.local-*.json
local-dev/system.*-e2e.json

# 头脑风暴可视化临时产物
.superpowers/

# IDE/工具工作目录（含 memory、skill、本地草稿等，不入库）
.workbuddy/

# Kiota 生成的 debug 端点目录需入库，避免被上面的 [Dd]ebug/ 构建产物规则误伤
!ui/src/api/client/**/debug/
!ui/src/api/client/**/debug/**
# Kiota 生成的 log 端点目录（notification/log）同理，别被 [Ll]og/ 构建产物规则吃掉
!ui/src/api/client/**/[Ll]og/
!ui/src/api/client/**/[Ll]og/**
.tmpbuild/
/.zcode/plans
/.tmp-ddl

# 独立输出目录的后端构建产物（宿主 bin 被并行实例锁定时用 -o local-dev/backend-dist 验证）
local-dev/mq-producer/
local-dev/mq-server/
local-dev/backend-dist/
# 仪表盘验收的前端构建快照（保留脚本与截图）
/local-dev/dashboard-editor-delivery-*/
/local-dev/dashboard-editor-final-*/
/local-dev/dashboard-editor-verify-*/
local-dev/backend-*.log
# 测试独立输出目录（-o local-dev/test-dist，同上绕宿主 bin 锁）
local-dev/test-dist/
/tmp/

# Docker Compose 环境变量（含基础设施密码，勿提交）
.env
.env.local

# 由 deploy/deploy-compose.sh 从 .env 生成的运行时配置（模板见 configs/system.example.json）
/configs/system.json
/configs/system.runtime.json
# 本机私有运行时配置（含内网 IP/密码/AES 密钥），同上用 system.example.json 作模板
/configs/system.yaml
/configs/plugins/
/.playwright-cli
/outputs
/preproc.xml
/website
.commandcode/
# Mimosa security scan artifacts
.mimosa/

# DuckDB/SQLite 本地数据目录（运行时产物，不入库）
/data/
/src/SData/data/
# 宿主内嵌前端为构建产物（Dockerfile 从 ui 构建拷贝），不入库
/src/SData/wwwroot/

# SData：ui pnpm workspace 子包（packages 目录为源码，勿套用上方 VS 模板的 NuGet packages 忽略规则）
# 说明：T612 的 rum-sdk 曾被 **/[Pp]ackages/* 误忽略从未入库，T614 发现后修复并补录
!ui/packages/**
ui/packages/**/node_modules/
ui/packages/**/.mimosa/

# 发布边界：本机工具状态、验收产物和运行时配置不入库
/.zcode/
/local-dev/
/src/SData/configs/
.env.*
!.env.example
!.env.sample
*.local.json
*.local.yaml
*.local.yml

